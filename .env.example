DJANGO_DEBUG=1
DJANGO_SECRET_KEY=local-development-only-change-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Set to 1 only when a trusted reverse proxy terminates HTTPS and sends
# X-Forwarded-Proto.
DJANGO_BEHIND_HTTPS_PROXY=0
# Optional: an existing, writable directory on persistent storage.
# Relative paths resolve against the project directory.
# SQLITE_PATH=/path/to/persistent/flow_portal.sqlite3

DIFY_READ_TIMEOUT=120
